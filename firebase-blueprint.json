{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique user ID matching request.auth.uid" },
        "email": { "type": "string", "description": "User email" },
        "displayName": { "type": "string", "description": "User friendly display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Category": {
      "title": "Category",
      "description": "Clinical diagnosis category containing cases",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique category identifier" },
        "userId": { "type": "string", "description": "Owner user ID matching request.auth.uid" },
        "name": { "type": "string", "description": "Category title name" },
        "subcategories": {
          "type": "array",
          "description": "List of subcategories associated with this category"
        },
        "cases": {
          "type": "array",
          "description": "Clinical cases inside this category"
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "name", "cases"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private profile entry of the user"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "User list of clinical diagnostic categories and cases"
    }
  }
}
